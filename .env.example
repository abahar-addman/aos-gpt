# Port Configuration
OPEN_WEBUI_PORT=1776
PIPELINES_PORT=9099

# CORS & Forwarding
CORS_ALLOW_ORIGIN=*
FORWARDED_ALLOW_IPS=*

# Analytics & Telemetry
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Ollama (for dev)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Database (Optional - leave empty if not using)
DATABASE_URL=

# Vector Database (Optional)
VECTOR_DB=
PGVECTOR_DB_URL=

# Azure Blob Storage (Optional)
STORAGE_PROVIDER=
AZURE_STORAGE_ENDPOINT=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_KEY=
AZURE_PIPELINE_CONTAINER_NAME=aos-pipeline

# Redis (Optional)
REDIS_URL=

# Security
WEBUI_SECRET_KEY=your-secret-key-here

# Logging / Datadog
# LOG_FORMAT: "json" for prod (Datadog parses JSON stdout natively) or "text" for local dev.
# Kept consistent with the edison-ai container so both services log identically.
LOG_FORMAT=json
GLOBAL_LOG_LEVEL=INFO
# Unified Service Tagging. DD_SERVICE is set per-container in
# docker-compose.pipelines.yaml (aos-pipelines); DD_ENV is shared here.
DD_ENV=dev
