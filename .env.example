# Port Configuration
OPEN_WEBUI_PORT=1776
PIPELINES_PORT=9099

# CORS & Forwarding
CORS_ALLOW_ORIGIN=*
FORWARDED_ALLOW_IPS=*

# Analytics & Telemetry
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Ollama (for dev)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Database (Optional - leave empty if not using)
DATABASE_URL=

# Vector Database (Optional)
VECTOR_DB=
PGVECTOR_DB_URL=

# Azure Blob Storage (Optional)
STORAGE_PROVIDER=
AZURE_STORAGE_ENDPOINT=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_KEY=
AZURE_PIPELINE_CONTAINER_NAME=aos-pipeline

# Redis (Optional)
REDIS_URL=

# Audio — Speech-to-Text / Text-to-Speech
# WHISPER_LANGUAGE applies to the in-container faster-whisper model (AUDIO_STT_ENGINE empty).
WHISPER_LANGUAGE=en
# STT: set ENGINE=openai to use a self-hosted OpenAI-compatible Whisper server.
# Leave the API key empty for servers with no auth — the backend then omits the
# Authorization header entirely instead of sending a bare "Bearer ".
AUDIO_STT_ENGINE=
AUDIO_STT_OPENAI_API_BASE_URL=
AUDIO_STT_OPENAI_API_KEY=
AUDIO_STT_MODEL=
# TTS: empty means the browser's Web Speech API (no backend call). Only set
# AUDIO_TTS_OPENAI_API_BASE_URL to a real text-to-speech server — pointing it at an
# STT/Whisper host makes /audio/speech return 404, since STT hosts only serve
# /audio/transcriptions.
AUDIO_TTS_ENGINE=
AUDIO_TTS_OPENAI_API_BASE_URL=
AUDIO_TTS_OPENAI_API_KEY=

# Security
WEBUI_SECRET_KEY=your-secret-key-here

# Logging / Datadog
# LOG_FORMAT: "json" for prod (Datadog parses JSON stdout natively) or "text" for local dev.
# Kept consistent with the edison-ai container so both services log identically.
LOG_FORMAT=json
GLOBAL_LOG_LEVEL=INFO
# Unified Service Tagging. DD_SERVICE is set per-container in
# docker-compose.pipelines.yaml (aos-pipelines); DD_ENV is shared here.
DD_ENV=dev
