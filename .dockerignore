# Git and IDE
.git
.github
.DS_Store
.idea
.vscode

# Documentation
docs
kubernetes

# Dependencies - these get installed fresh in the container
node_modules
**/node_modules

# SvelteKit build artifacts (critical - these are huge!)
.svelte-kit
**/.svelte-kit

# Package output
package

# Environment files
.env
.env.*
!.env.example

# Build timestamps
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Python
__pycache__
**/__pycache__
*.pyc
*.pyo
venv
**/venv
**/.venv
backend/venv
.ipynb_checkpoints

# Build outputs (frontend build happens in container)
build
dist

# Data and uploads (should be mounted as volumes)
backend/data/*
!backend/data/readme.txt
uploads
**/uploads

# Database files
**/*.db

# Test and temp files
_old
_test
cypress/videos
cypress/screenshots

# Large binary/wasm files that shouldn't be in context
**/*.wasm
**/pyodide/*.whl

# Static pyodide (will be built/downloaded in container if needed)
static/pyodide

# The dev-mode static mirror in backend/open_webui/config.py copies the frontend
# `static/` tree into the backend's STATIC_DIR, so a developer's working tree can
# hold a full pyodide copy here. Nothing serves it — /pyodide is mounted from the
# frontend build (main.py) — and `COPY ./backend .` would otherwise pull whatever
# happens to be on that machine into the image. Excluded regardless of local state.
backend/open_webui/static/pyodide
backend/open_webui/static/assets/welcome.mp4
backend/open_webui/static/assets/welcome.webp
